# .env.example - cópia de exemplo para desenvolvimento
# Não comite informações sensíveis em repositórios públicos.
# Copie este arquivo para ".env" e ajuste conforme necessário.

# Configurações do banco (dev)
DB_HOST=viacoes_php_demo_db
DB_NAME=viacoes_demo
DB_USER=viacoes_user
DB_PASSWORD=viacoes_pass

# MySQL container (usado pelo docker-compose)
MYSQL_DATABASE=viacoes_demo
MYSQL_USER=viacoes_user
MYSQL_PASSWORD=viacoes_pass
MYSQL_ROOT_PASSWORD=root123

# Token simples para proteger a API de exemplo
API_TOKEN=changeme

# Dicas:
# - Faça: `cp .env.example .env`
# - Edite .env com os valores locais que quiser usar.